# Copy to .env (git-ignored). Never commit real values.
META_API_KEY=
# Optional: where usage lines are written (defaults to ./usage.jsonl, git-ignored)
USAGE_LOG=usage.jsonl
# WhatsApp Cloud API (Meta for Developers > WhatsApp > API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER=
# Webhook: the token you type in the app's webhook settings, and the app secret that signs each delivery
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Encrypted memory: 32 random bytes, base64
ESCALA_MEMORY_KEY=
# Test phase (D43). Refs of the numbers enrolled by hand, comma-separated (made by the team's enrolment script, never
# the numbers). Empty: anyone may write and nothing is transcribed.
ESCALA_TESTERS=
# Public key (PEM in base64) that seals testers' conversations in the log; the private key stays with the team.
TRANSCRIPT_PUBLIC_KEY=
# Last day transcripts are written (UTC, YYYY-MM-DD). Defaults to 2026-11-30.
TRANSCRIPT_UNTIL=
